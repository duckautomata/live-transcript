{
    "name": "live-transcript",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "format": "oxfmt .",
        "format:check": "oxfmt --check .",
        "lint": "oxlint .",
        "lint:fix": "oxlint --fix .",
        "test": "vitest run",
        "test:ci": "vitest run --reporter=junit --outputFile=junit.xml",
        "test:generate-mocks": "node tests/mocks/generate-snapshot.mjs && node tests/mocks/generate-consts.js",
        "test:mock": "playwright test --config=playwright.mock.config.js",
        "test:dev": "playwright test --config=playwright.dev.config.js",
        "test:e2e": "playwright test"
    },
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@fontsource/roboto": "^5.3.0",
        "@mui/icons-material": "^9.4.0",
        "@mui/material": "^9.4.0",
        "@mui/x-charts": "^9.13.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-h5-audio-player": "^3.10.2",
        "react-router-dom": "^7.18.3",
        "react-use-websocket": "^4.13.0",
        "react-virtuoso": "^4.18.12",
        "wavesurfer.js": "^7.12.11",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "@vitejs/plugin-react": "^6.1.1",
        "esbuild": "^0.28.2",
        "oxfmt": "^0.66.0",
        "oxlint": "^1.81.0",
        "playwright": "^1.63.0",
        "vite": "^8.2.2",
        "vitest": "^5.0.0",
        "wrangler": "^4.129.0"
    }
}
